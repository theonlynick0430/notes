\@writefile{lof}{\contentsline {figure}{\numberline {10.1}{\ignorespaces {\sffamily  \textbf  {Illustration of Progressive Distillation (PD).}} At each round, the student model is trained so that a single step reproduces the effect of two adjacent teacher steps. This process distills $N$ teacher steps into $N/2$ student steps, and repeating the procedure progressively halves the trajectory length until the desired step count is reached. The arrows indicate how multi-step teacher transitions are compressed into fewer student steps, moving from data to noise. \figcredit  {Created by the authors.} }}{322}{figure.caption.368}\protected@file@percent }
\newlabel{fig:pd-illustration}{{10.1}{322}{\textbfs {Illustration of Progressive Distillation (PD).} At each round, the student model is trained so that a single step reproduces the effect of two adjacent teacher steps. This process distills $N$ teacher steps into $N/2$ student steps, and repeating the procedure progressively halves the trajectory length until the desired step count is reached. The arrows indicate how multi-step teacher transitions are compressed into fewer student steps, moving from data to noise. \figcredit {Created by the authors.}}{figure.caption.368}{}}
\newlabel{fig:pd-illustration@cref}{{[figure][1][10]10.1}{[1][322][]322}{}{}{}}

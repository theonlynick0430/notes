\@writefile{lof}{\contentsline {figure}{\numberline {12.4}{\ignorespaces {\sffamily  \textbf  {Illustration of masked and uniform diffusion forward corruption and reverse generation.}} The two examples shown here admit an interpolating marginal of the form $\Pr ({\mathbf  {x}}_t|{\mathbf  {x}}_0)=\mathrm  {Cat}({\mathbf  {x}}_t;\alpha _t{\mathbf  {x}}_0+(1-\alpha _t)\bm  {\pi })$, where the limiting prior $\bm  {\pi }$ and decay factor $\alpha _t$ are determined by the chosen forward rate matrix. In masked diffusion, tokens are absorbed into the mask state, with limiting prior $\bm  {\pi }={\mathbf  {m}}={\mathbf  {e}}_K$. In uniform diffusion, tokens are repeatedly randomized, with limiting prior $\bm  {\pi }_{\mathrm  {unif}}=\frac  {1}{K}\mathbf  {1}$. Generation reverses the chosen corruption process, starting from the corresponding simple reference distribution, or from a close finite-time approximation to it. \figcredit  {Created by the authors with AI-assisted coding.}}}{386}{figure.caption.440}\protected@file@percent }
\newlabel{fig:mask-uniform}{{12.4}{386}{\textbfs {Illustration of masked and uniform diffusion forward corruption and reverse generation.} The two examples shown here admit an interpolating marginal of the form $\Pr (\rvx _t|\rvx _0)=\mathrm {Cat}(\rvx _t;\alpha _t\rvx _0+(1-\alpha _t)\bm {\pi })$, where the limiting prior $\bm {\pi }$ and decay factor $\alpha _t$ are determined by the chosen forward rate matrix. In masked diffusion, tokens are absorbed into the mask state, with limiting prior $\bm {\pi }=\rvm =\rve _K$. In uniform diffusion, tokens are repeatedly randomized, with limiting prior $\bm {\pi }_{\mathrm {unif}}=\frac {1}{K}\mathbf {1}$. Generation reverses the chosen corruption process, starting from the corresponding simple reference distribution, or from a close finite-time approximation to it. \figcredit {Created by the authors with AI-assisted coding.}}{figure.caption.440}{}}
\newlabel{fig:mask-uniform@cref}{{[figure][4][12]12.4}{[1][386][]386}{}{}{}}
\@writefile{toc}{\contentsline {paragraph}{Forward Corruption.}{386}{paragraph*.441}\protected@file@percent }

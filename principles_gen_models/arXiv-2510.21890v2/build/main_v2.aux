\@writefile{lof}{\contentsline {figure}{\numberline {11.8}{\ignorespaces {\sffamily  \textbf  {Eulerian consistency of flow maps.}} The target time $t$ is fixed, while the source time is moved from $s$ to $s'$. Since the source points lie on the same PF-ODE trajectory, the output of the flow map should remain unchanged: ${\bm  {\Psi }}_{s\to t}({\mathbf  {x}}_s)={\bm  {\Psi }}_{s'\to t}({\mathbf  {x}}_{s'})$. Infinitesimally, this gives $\frac  {\mathop {}\!\mathrm  {d}}{\mathop {}\!\mathrm  {d}s}{\bm  {\Psi }}_{s\to t}({\mathbf  {x}}_s)=0$, or equivalently $\partial _s{\bm  {\Psi }}_{s\to t}({\mathbf  {x}}_s) +(\partial _{{\mathbf  {x}}}{\bm  {\Psi }}_{s\to t})({\mathbf  {x}}_s){\mathbf  {v}}^*({\mathbf  {x}}_s,s)=0$.}}{369}{figure.caption.426}\protected@file@percent }
\newlabel{fig:eulerian-consistency}{{11.8}{369}{\textbfs {Eulerian consistency of flow maps.} The target time $t$ is fixed, while the source time is moved from $s$ to $s'$. Since the source points lie on the same PF-ODE trajectory, the output of the flow map should remain unchanged: $\bPsi _{s\to t}(\rvx _s)=\bPsi _{s'\to t}(\rvx _{s'})$. Infinitesimally, this gives $\frac {\diff }{\diff s}\bPsi _{s\to t}(\rvx _s)=0$, or equivalently $\partial _s\bPsi _{s\to t}(\rvx _s) +(\partial _{\rvx }\bPsi _{s\to t})(\rvx _s)\rvv ^*(\rvx _s,s)=0$}{figure.caption.426}{}}
\newlabel{fig:eulerian-consistency@cref}{{[figure][8][11]11.8}{[1][369][]369}{}{}{}}

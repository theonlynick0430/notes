\@writefile{lof}{\contentsline {figure}{\numberline {12.2}{\ignorespaces {\sffamily  \textbf  {From sequences to one-hot states.}} A data sample such as a text or protein sequence consists of $N$ tokens, each taking values in a finite alphabet or vocabulary of size~$K$. This chapter focuses on the evolution of a single token among $K$ states. Zooming in on one position, here ``cat'', the token is represented by the basis vector ${\mathbf  {e}}_2$ and encoded as a one-hot vector in $\{0,1\}^K$, namely a $K$-dimensional vector whose second entry is~$1$ and all other entries are~$0$. The state space $\mathcal  {V}=\{{\mathbf  {x}}\in \{0,1\}^K:\DOTSB \sum@ \slimits@ _{i=1}^K x_i=1\} =\{{\mathbf  {e}}_1,\ldots  ,{\mathbf  {e}}_K\}$ is the set of all such one-hot vectors. The ordering of the vocabulary entries is arbitrary and unrelated to the position of a token in the sequence. \figcredit  {Created by the authors with AI-assisted coding.}}}{381}{figure.caption.433}\protected@file@percent }
\newlabel{fig:notation-overview}{{12.2}{381}{\textbfs {From sequences to one-hot states.} A data sample such as a text or protein sequence consists of $N$ tokens, each taking values in a finite alphabet or vocabulary of size~$K$. This chapter focuses on the evolution of a single token among $K$ states. Zooming in on one position, here ``cat'', the token is represented by the basis vector $\rve _2$ and encoded as a one-hot vector in $\{0,1\}^K$, namely a $K$-dimensional vector whose second entry is~$1$ and all other entries are~$0$. The state space $\mathcal {V}=\{\rvx \in \{0,1\}^K:\sum _{i=1}^K x_i=1\} =\{\rve _1,\ldots ,\rve _K\}$ is the set of all such one-hot vectors. The ordering of the vocabulary entries is arbitrary and unrelated to the position of a token in the sequence. \figcredit {Created by the authors with AI-assisted coding.}}{figure.caption.433}{}}
\newlabel{fig:notation-overview@cref}{{[figure][2][12]12.2}{[1][380][]381}{}{}{}}

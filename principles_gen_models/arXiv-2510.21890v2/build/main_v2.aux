\newlabel{eq:ddpm-forward@cref}{{[equation][1][2,2]2.2.1}{[1][42][]42}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.2.2}Reverse Denoising Process (Learnable Decoder)}{43}{subsection.2.2.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2.5}{\ignorespaces {\sffamily  \textbf  {Illustration of DDPM reverse (denoising) process.}} Starting from noise $\mathbf  {x}_L \sim p_{\mathrm  {prior}}$, the model sequentially samples $\mathbf  {x}_{i-1} \sim p(\mathbf  {x}_{i-1}|\mathbf  {x}_i)$ for $i=L,\ldots  ,1$ to obtain a newly generated data $\mathbf  {x}_0$. The oracle transition $p(\mathbf  {x}_{i-1}|\mathbf  {x}_i)$ is unknown; thus, we aim to approximate it. \figcredit  {Created by the authors.} }}{43}{figure.caption.58}\protected@file@percent }
\newlabel{fig:ddpm-sampling-formal-rev}{{2.5}{43}{\textbfs {Illustration of DDPM reverse (denoising) process.} Starting from noise $\mathbf {x}_L \sim p_{\mathrm {prior}}$, the model sequentially samples $\mathbf {x}_{i-1} \sim p(\mathbf {x}_{i-1}|\mathbf {x}_i)$ for $i=L,\ldots ,1$ to obtain a newly generated data $\mathbf {x}_0$. The oracle transition $p(\mathbf {x}_{i-1}|\mathbf {x}_i)$ is unknown; thus, we aim to approximate it. \figcredit {Created by the authors.}}{figure.caption.58}{}}
\newlabel{fig:ddpm-sampling-formal-rev@cref}{{[figure][5][2]2.5}{[1][43][]43}{}{}{}}
\@writefile{toc}{\contentsline {paragraph}{Overview: Modeling and Training Objective.}{43}{paragraph*.59}\protected@file@percent }
\newlabel{eq:marginal-kl-matching}{{2.2.2}{43}{Overview: Modeling and Training Objective}{equation.2.2.2}{}}
\newlabel{eq:marginal-kl-matching@cref}{{[equation][2][2,2]2.2.2}{[1][43][]43}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.6}{\ignorespaces {\sffamily  \textbf  {Illustration of the conditioning trick in DDPM.}} For a fixed noisy sample ${\mathbf  {x}}_i$, the true reverse distribution $p({\mathbf  {x}}_{i-1}|{\mathbf  {x}}_i)$ is induced by marginalizing over all possible clean origins ${\mathbf  {x}}_0$, and is therefore generally a mixture that can be multimodal. Its mean may even fall between modes, making direct prediction difficult. By contrast, once we condition on the clean sample ${\mathbf  {x}}_0$, the reverse posterior $p({\mathbf  {x}}_{i-1}|{\mathbf  {x}}_i,{\mathbf  {x}}_0)$ becomes a single Gaussian. DDPM exploits this tractable conditional structure during training, replacing a difficult multimodal prediction problem with a tractable regression target. \figcredit  {Created by the authors with AI-assisted coding.}}}{44}{figure.caption.60}\protected@file@percent }
\newlabel{fig:conditional-trick}{{2.6}{44}{\textbfs {Illustration of the conditioning trick in DDPM.} For a fixed noisy sample $\rvx _i$, the true reverse distribution $p(\rvx _{i-1}|\rvx _i)$ is induced by marginalizing over all possible clean origins $\rvx _0$, and is therefore generally a mixture that can be multimodal. Its mean may even fall between modes, making direct prediction difficult. By contrast, once we condition on the clean sample $\rvx _0$, the reverse posterior $p(\rvx _{i-1}|\rvx _i,\rvx _0)$ becomes a single Gaussian. DDPM exploits this tractable conditional structure during training, replacing a difficult multimodal prediction problem with a tractable regression target. \figcredit {Created by the authors with AI-assisted coding.}}{figure.caption.60}{}}
\newlabel{fig:conditional-trick@cref}{{[figure][6][2]2.6}{[1][44][]44}{}{}{}}
\@writefile{toc}{\contentsline {paragraph}{Overcoming Intractability with Conditioning.}{44}{paragraph*.61}\protected@file@percent }

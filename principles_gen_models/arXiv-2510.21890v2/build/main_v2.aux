\@writefile{lof}{\contentsline {figure}{\numberline {5.7}{\ignorespaces {\sffamily  \textbf  {The conditional trick in conditional flow matching (with ${\mathbf  {z}}={\mathbf  {x}}_1\sim p_{\mathrm  {tgt}}$).}} The marginal velocity ${\mathbf  {v}}_t({\mathbf  {x}}_t)=\mathbb  {E}_{{\mathbf  {x}}_1\sim p(\cdot |{\mathbf  {x}}_t)}[{\mathbf  {v}}_t({\mathbf  {x}}_t|{\mathbf  {x}}_1)]$ (left) is a weighted average of conditional velocities over all target points ${\mathbf  {x}}_1\sim p_{\mathrm  {tgt}}$, weighted by how likely each ${\mathbf  {x}}_1$ is to have produced the current ${\mathbf  {x}}_t$, and is generally intractable to compute. For a fixed ${\mathbf  {x}}_1$, however, the conditional velocity has the closed form ${\mathbf  {v}}_t({\mathbf  {x}}_t|{\mathbf  {x}}_1)=b_t'{\mathbf  {x}}_1+(a_t'/a_t)({\mathbf  {x}}_t-b_t{\mathbf  {x}}_1)$ (Proposition~\ref {closed-form-vf}; right). Colored arrows show these conditional velocities, and the black arrow is their weighted average. Conditional flow matching (Theorem~\ref {thm:fm-cfm}) trains on these tractable conditional targets while attaining the same optimum as regression on the intractable marginal velocity. This is analogous to the conditional trick in the variational perspective (Theorem~\ref {thm:equiv-marginal-kl}) and in denoising score matching (Theorem~\ref {thm:sm-dsm}). \figcredit  {Created by the authors with AI-assisted coding.}}}{139}{figure.caption.172}\protected@file@percent }
\newlabel{fig:cfm-illustration}{{5.7}{139}{\textbfs {The conditional trick in conditional flow matching (with $\rvz =\rvx _1\sim p_{\mathrm {tgt}}$).} The marginal velocity $\rvv _t(\rvx _t)=\mathbb {E}_{\rvx _1\sim p(\cdot |\rvx _t)}[\rvv _t(\rvx _t|\rvx _1)]$ (left) is a weighted average of conditional velocities over all target points $\rvx _1\sim p_{\mathrm {tgt}}$, weighted by how likely each $\rvx _1$ is to have produced the current $\rvx _t$, and is generally intractable to compute. For a fixed $\rvx _1$, however, the conditional velocity has the closed form $\rvv _t(\rvx _t|\rvx _1)=b_t'\rvx _1+(a_t'/a_t)(\rvx _t-b_t\rvx _1)$ (Proposition~\ref {closed-form-vf}; right). Colored arrows show these conditional velocities, and the black arrow is their weighted average. Conditional flow matching (Theorem~\ref {thm:fm-cfm}) trains on these tractable conditional targets while attaining the same optimum as regression on the intractable marginal velocity. This is analogous to the conditional trick in the variational perspective (Theorem~\ref {thm:equiv-marginal-kl}) and in denoising score matching (Theorem~\ref {thm:sm-dsm}). \figcredit {Created by the authors with AI-assisted coding.}}{figure.caption.172}{}}
\newlabel{fig:cfm-illustration@cref}{{[figure][7][5]5.7}{[1][138][]139}{}{}{}}

\@writefile{lof}{\contentsline {figure}{\numberline {1.2}{\ignorespaces {\sffamily  \textbf  {Computation graphs of prominent deep generative models.}} Top to bottom: {\sffamily  \textbf  {EBM}} maps an input ${\mathbf  {x}}$ to a scalar energy; {\sffamily  \textbf  {AR}} generates a sequence $\{{\mathbf  {x}}_\ell \}_{\ell =0}^{L}$ left to right with causal dependencies; {\sffamily  \textbf  {VAE}} encodes ${\mathbf  {x}}$ to a latent ${\mathbf  {z}}$ and decodes to a reconstruction ${\mathbf  {x}}'$; {\sffamily  \textbf  {NF}} applies an invertible map ${\mathbf  {f}}_{\bm  {\phi }}$ between ${\mathbf  {x}}$ and ${\mathbf  {z}}$ and uses ${\mathbf  {f}}_{\bm  {\phi }}^{-1}$ to produce ${\mathbf  {x}}'$; {\sffamily  \textbf  {GAN}} transforms noise ${\mathbf  {z}}$ to a sample ${\mathbf  {x}}'$ that is judged against real ${\mathbf  {x}}$ by a discriminator $D_{\bm  {\zeta }}$; {\sffamily  \textbf  {DM}} iteratively refines a noisy sample through a multi-step denoising chain $\{{\mathbf  {x}}_\ell \}_{\ell =0}^{L}$. Boxes denote variables, trapezoids are learnable networks, ovals are scalars; arrows indicate computation flow. The trapezoid was intended to indicate a dimension-changing transformation, while rectangles denote variables or mappings that preserve dimensionality. \figcredit  {Created by the authors.}}}{27}{figure.caption.32}\protected@file@percent }
\newlabel{fig:ebm-ar-vae-nf-gan-dm-unified}{{1.2}{27}{\textbfs {Computation graphs of prominent deep generative models.} Top to bottom: \textbfs {EBM} maps an input $\rvx $ to a scalar energy; \textbfs {AR} generates a sequence $\{\rvx _\ell \}_{\ell =0}^{L}$ left to right with causal dependencies; \textbfs {VAE} encodes $\rvx $ to a latent $\rvz $ and decodes to a reconstruction $\rvx '$; \textbfs {NF} applies an invertible map $\rvf _\bphi $ between $\rvx $ and $\rvz $ and uses $\rvf _\bphi ^{-1}$ to produce $\rvx '$; \textbfs {GAN} transforms noise $\rvz $ to a sample $\rvx '$ that is judged against real $\rvx $ by a discriminator $D_{\bm \zeta }$; \textbfs {DM} iteratively refines a noisy sample through a multi-step denoising chain $\{\rvx _\ell \}_{\ell =0}^{L}$. Boxes denote variables, trapezoids are learnable networks, ovals are scalars; arrows indicate computation flow. The trapezoid was intended to indicate a dimension-changing transformation, while rectangles denote variables or mappings that preserve dimensionality. \figcredit {Created by the authors.}}{figure.caption.32}{}}
\newlabel{fig:ebm-ar-vae-nf-gan-dm-unified@cref}{{[figure][2][1]1.2}{[1][22][]27}{}{}{}}

\@writefile{lof}{\contentsline {figure}{\numberline {11.7}{\ignorespaces {\sffamily  \textbf  {Lagrangian consistency of flow maps.}} The source $({\mathbf  {x}}_s,s)$ is fixed, and the target time is moved from $t$ to $t'$. The output of the flow map moves along the same PF-ODE trajectory, and its infinitesimal change equals the ODE velocity: $\partial _t {\bm  {\Psi }}_{s\to t}({\mathbf  {x}}_s) = {\mathbf  {v}}^*({\bm  {\Psi }}_{s\to t}({\mathbf  {x}}_s),t)$.}}{368}{figure.caption.423}\protected@file@percent }
\newlabel{fig:lagrangian-consistency}{{11.7}{368}{\textbfs {Lagrangian consistency of flow maps.} The source $(\rvx _s,s)$ is fixed, and the target time is moved from $t$ to $t'$. The output of the flow map moves along the same PF-ODE trajectory, and its infinitesimal change equals the ODE velocity: $\partial _t \bPsi _{s\to t}(\rvx _s) = \rvv ^*(\bPsi _{s\to t}(\rvx _s),t)$}{figure.caption.423}{}}
\newlabel{fig:lagrangian-consistency@cref}{{[figure][7][11]11.7}{[1][367][]368}{}{}{}}

\@writefile{lof}{\contentsline {figure}{\numberline {9.3}{\ignorespaces  {\sffamily  \textbf  {Plain Heun update in log-SNR time.}} Starting from the previous state $\hat  {\mathbf  {x}}_{i-1}$ at $\lambda _{i-1}$, the \emph  {predictor} step (blue arrow) performs an explicit Euler move $h {\mathbf  {F}}(\hat  {\mathbf  {x}}_{i-1}, \lambda _{i-1})$ to obtain the intermediate estimate $\hat  {\mathbf  {x}}^{\mathrm  {mid}}_i$. At this predicted point, the \emph  {corrector} step evaluates the new slope $h {\mathbf  {F}}(\hat  {\mathbf  {x}}^{\mathrm  {mid}}_i, \lambda _i)$ (green arrow) and combines both slopes through a parallelogram construction: the dashed orange diagonal represents the vector sum $h\big  ({\mathbf  {F}}(\hat  {{\mathbf  {x}}}_{i-1},\lambda _{i-1}) + {\mathbf  {F}}(\hat  {{\mathbf  {x}}}^{\mathrm  {mid}}_{i},\lambda _{i})\big  )$ starting from $\hat  {\mathbf  {x}}_{i-1}$, and the solid orange arrow is its half-diagonal, having the same direction but half the length. This procedure realizes the plain Heun integration of the PF-ODE trajectory in log-SNR time. \figcredit  {Created by the authors.} }}{292}{figure.caption.340}\protected@file@percent }
\newlabel{fig:plain-heun}{{9.3}{292}{\textbfs {Plain Heun update in log-SNR time.} Starting from the previous state $\hat {\mathbf {x}}_{i-1}$ at $\lambda _{i-1}$, the \emph {predictor} step (blue arrow) performs an explicit Euler move $h \rmF (\hat {\mathbf {x}}_{i-1}, \lambda _{i-1})$ to obtain the intermediate estimate $\hat {\mathbf {x}}^{\mathrm {mid}}_i$. At this predicted point, the \emph {corrector} step evaluates the new slope $h \rmF (\hat {\mathbf {x}}^{\mathrm {mid}}_i, \lambda _i)$ (green arrow) and combines both slopes through a parallelogram construction: the dashed orange diagonal represents the vector sum $h\big (\rmF (\hat {\rvx }_{i-1},\lambda _{i-1}) + \rmF (\hat {\rvx }^{\mathrm {mid}}_{i},\lambda _{i})\big )$ starting from $\hat \rvx _{i-1}$, and the solid orange arrow is its half-diagonal, having the same direction but half the length. This procedure realizes the plain Heun integration of the PF-ODE trajectory in log-SNR time. \figcredit {Created by the authors.}}{figure.caption.340}{}}
\newlabel{fig:plain-heun@cref}{{[figure][3][9]9.3}{[1][292][]292}{}{}{}}
\@writefile{toc}{\contentsline {paragraph}{Plain Heun update.}{292}{paragraph*.341}\protected@file@percent }

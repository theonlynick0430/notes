\@writefile{lof}{\contentsline {figure}{\numberline {1.1}{\ignorespaces {\sffamily  \textbf  {Illustration of the target in DGM.}} Training a DGM is essentially minimizing the discrepancy between the model distribution $p_{\bm  {\phi }}$ and the unknown data distribution $p_{\mathrm  {data}}$. Since $p_{\mathrm  {data}}$ is not directly accessible, this discrepancy must be estimated efficiently using a finite set of independent and identically distributed (i.i.d.) samples, ${\mathbf  {x}}_i$, drawn from it. \figcredit  {Created by the authors.}}}{18}{figure.caption.25}\protected@file@percent }
\newlabel{fig:dgm-training}{{1.1}{18}{\textbfs {Illustration of the target in DGM.} Training a DGM is essentially minimizing the discrepancy between the model distribution $p_{\bm {\phi }}$ and the unknown data distribution $p_{\mathrm {data}}$. Since $p_{\mathrm {data}}$ is not directly accessible, this discrepancy must be estimated efficiently using a finite set of independent and identically distributed (i.i.d.) samples, $\rvx _i$, drawn from it. \figcredit {Created by the authors.}}{figure.caption.25}{}}

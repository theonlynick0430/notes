\@writefile{lof}{\contentsline {figure}{\numberline {11.5}{\ignorespaces {\sffamily  \textbf  {Illustration of CTM's semigroup property.}} For any $s \ge u \ge t$, CTM enforces ${\mathbf  {G}}_{{\bm  {\theta }}}({\mathbf  {x}}_s, s, t) \approx {\mathbf  {G}}_{{\bm  {\theta }}^-} \big  (\mathtt  {Solver}_{s\to u}({\mathbf  {x}}_s), u , t\big  )$, i.e., a short solver segment $s \to u$ followed by a CTM ``jump'' to $t$ matches the direct CTM map $s\to t$. The solver may be a pre-trained diffusion or a CTM's self-induced teacher. \figcredit  {Adapted from \citet {kim2023consistency}.}}}{388}{figure.caption.407}\protected@file@percent }
\newlabel{fig:ill_models}{{11.5}{388}{\textbfs {Illustration of CTM's semigroup property.} For any $s \ge u \ge t$, CTM enforces $\rmG _{\btheta }(\rvx _s, s, t) \approx \rmG _{\btheta ^-} \big (\mathtt {Solver}_{s\to u}(\rvx _s), u , t\big )$, i.e., a short solver segment $s \to u$ followed by a CTM ``jump'' to $t$ matches the direct CTM map $s\to t$. The solver may be a pre-trained diffusion or a CTM's self-induced teacher. \figcredit {Adapted from \citet {kim2023consistency}.}}{figure.caption.407}{}}
\newlabel{fig:ill_models@cref}{{[figure][5][11]11.5}{[1][388][]388}{}{}{}}

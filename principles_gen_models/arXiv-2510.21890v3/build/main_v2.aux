\@writefile{lof}{\contentsline {figure}{\numberline {5.2}{\ignorespaces {\sffamily  \textbf  {Illustration of sample movement of NF under an invertible map.}} It consists of a sequence of invertible functions ${\mathbf  {f}}: {\mathbf  {z}}\DOTSB \mapstochar \rightarrow {\mathbf  {x}}$ that transform latent variable ${\mathbf  {z}}$ into a data ${\mathbf  {x}}$, together with the inverse mapping ${\mathbf  {f}}^{-1}: {\mathbf  {x}}\DOTSB \mapstochar \rightarrow {\mathbf  {z}}$ that reconstructs the data. An NF resembles an encoder--decoder structure, but with the encoder realized as a smooth invertible map and the decoder given exactly by its inverse. The corresponding change in density can be computed via the change-of-variables formula, as given in \Cref  {eq:nf-change-of-var}. \figcredit  {Created by the authors.}}}{136}{figure.caption.152}\protected@file@percent }
\newlabel{fig:sample-and-change-of-variable}{{5.2}{136}{\textbfs {Illustration of sample movement of NF under an invertible map.} It consists of a sequence of invertible functions $\rvf : \rvz \mapsto \rvx $ that transform latent variable $\rvz $ into a data $\rvx $, together with the inverse mapping $\rvf ^{-1}: \rvx \mapsto \rvz $ that reconstructs the data. An NF resembles an encoder--decoder structure, but with the encoder realized as a smooth invertible map and the decoder given exactly by its inverse. The corresponding change in density can be computed via the change-of-variables formula, as given in \Cref {eq:nf-change-of-var}. \figcredit {Created by the authors.}}{figure.caption.152}{}}
\newlabel{fig:sample-and-change-of-variable@cref}{{[figure][2][5]5.2}{[1][136][]136}{}{}{}}

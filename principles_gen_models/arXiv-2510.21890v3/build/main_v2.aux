\@writefile{lof}{\contentsline {figure}{\numberline {11.8}{\ignorespaces {\sffamily  \textbf  {Eulerian consistency of flow maps.}} The ending time $t$ is fixed, while the starting time is moved from $s$ to $s'$. Since the corresponding starting points lie on the same PF-ODE trajectory, the ending point remains unchanged: ${\bm  {\Psi }}_{s\to t}({\mathbf  {x}}_s)={\bm  {\Psi }}_{s'\to t}({\mathbf  {x}}_{s'})$. Infinitesimally, this gives $\frac  {\mathop {}\!\mathrm  {d}}{\mathop {}\!\mathrm  {d}s}{\bm  {\Psi }}_{s\to t}({\mathbf  {x}}_s)=0$, or equivalently $\partial _s{\bm  {\Psi }}_{s\to t}({\mathbf  {x}}_s) +(\partial _{{\mathbf  {x}}}{\bm  {\Psi }}_{s\to t})({\mathbf  {x}}_s){\mathbf  {v}}^*({\mathbf  {x}}_s,s)=0$.}}{400}{figure.caption.426}\protected@file@percent }
\newlabel{fig:eulerian-consistency}{{11.8}{400}{\textbfs {Eulerian consistency of flow maps.} The ending time $t$ is fixed, while the starting time is moved from $s$ to $s'$. Since the corresponding starting points lie on the same PF-ODE trajectory, the ending point remains unchanged: $\bPsi _{s\to t}(\rvx _s)=\bPsi _{s'\to t}(\rvx _{s'})$. Infinitesimally, this gives $\frac {\diff }{\diff s}\bPsi _{s\to t}(\rvx _s)=0$, or equivalently $\partial _s\bPsi _{s\to t}(\rvx _s) +(\partial _{\rvx }\bPsi _{s\to t})(\rvx _s)\rvv ^*(\rvx _s,s)=0$}{figure.caption.426}{}}
\newlabel{fig:eulerian-consistency@cref}{{[figure][8][11]11.8}{[1][400][]400}{}{}{}}

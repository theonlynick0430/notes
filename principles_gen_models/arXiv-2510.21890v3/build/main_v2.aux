\@writefile{lof}{\contentsline {figure}{\numberline {11.7}{\ignorespaces {\sffamily  \textbf  {Lagrangian consistency of flow maps.}} The starting state--time pair $({\mathbf  {x}}_s,s)$ is fixed, and the ending time is moved from $t$ to $t'$. The output of the flow map moves along the same PF-ODE trajectory, and its infinitesimal change equals the ODE velocity: $\partial _t {\bm  {\Psi }}_{s\to t}({\mathbf  {x}}_s) = {\mathbf  {v}}^*({\bm  {\Psi }}_{s\to t}({\mathbf  {x}}_s),t)$.}}{399}{figure.caption.423}\protected@file@percent }
\newlabel{fig:lagrangian-consistency}{{11.7}{399}{\textbfs {Lagrangian consistency of flow maps.} The starting state--time pair $(\rvx _s,s)$ is fixed, and the ending time is moved from $t$ to $t'$. The output of the flow map moves along the same PF-ODE trajectory, and its infinitesimal change equals the ODE velocity: $\partial _t \bPsi _{s\to t}(\rvx _s) = \rvv ^*(\bPsi _{s\to t}(\rvx _s),t)$}{figure.caption.423}{}}

\@writefile{lof}{\contentsline {figure}{\numberline {12.3}{\ignorespaces {\sffamily  \textbf  {Illustration of a CTMC sample path.}} Let the state space be $\mathcal  {V}=\{{\mathbf  {e}}_1,{\mathbf  {e}}_2,{\mathbf  {e}}_3\}$, labeled as $S_1,S_2,S_3$ on the vertical axis. The trajectory is piecewise constant: the process remains at ${\mathbf  {x}}_t={\mathbf  {e}}_i$ for a random holding time, then jumps instantaneously to another state ${\mathbf  {e}}_j$ at times $t_1,t_2,\ldots  $. Filled circles mark the state occupied immediately after each jump, and open circles the state just before the jump, reflecting the right-continuous convention. The dotted segment indicates continuation beyond the displayed window. These jump times and destinations are governed by the rate matrix ${\mathbf  {Q}}_t$: from state ${\mathbf  {e}}_i$, the process jumps to ${\mathbf  {e}}_j$ ($j\neq  i$) at instantaneous rate $[{\mathbf  {Q}}_t]_{ij}$. \figcredit  {Adapted from \citet {campbell2022continuous}.}}}{416}{figure.caption.439}\protected@file@percent }
\newlabel{fig:ctmc-trajectory}{{12.3}{416}{\textbfs {Illustration of a CTMC sample path.} Let the state space be $\mathcal {V}=\{\rve _1,\rve _2,\rve _3\}$, labeled as $S_1,S_2,S_3$ on the vertical axis. The trajectory is piecewise constant: the process remains at $\rvx _t=\rve _i$ for a random holding time, then jumps instantaneously to another state $\rve _j$ at times $t_1,t_2,\ldots $. Filled circles mark the state occupied immediately after each jump, and open circles the state just before the jump, reflecting the right-continuous convention. The dotted segment indicates continuation beyond the displayed window. These jump times and destinations are governed by the rate matrix $\rmQ _t$: from state $\rve _i$, the process jumps to $\rve _j$ ($j\neq i$) at instantaneous rate $[\rmQ _t]_{ij}$. \figcredit {Adapted from \citet {campbell2022continuous}.}}{figure.caption.439}{}}
\newlabel{fig:ctmc-trajectory@cref}{{[figure][3][12]12.3}{[1][416][]416}{}{}{}}

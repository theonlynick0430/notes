\@writefile{lof}{\contentsline {figure}{\numberline {2.5}{\ignorespaces {\sffamily  \textbf  {Illustration of DDPM reverse (denoising) process.}} Starting from noise $\mathbf  {x}_L \sim p_{\mathrm  {prior}}$, the model sequentially samples $\mathbf  {x}_{i-1} \sim p(\mathbf  {x}_{i-1}|\mathbf  {x}_i)$ for $i=L,\ldots  ,1$ to obtain a newly generated data $\mathbf  {x}_0$. The oracle transition $p(\mathbf  {x}_{i-1}|\mathbf  {x}_i)$ is unknown; thus, we aim to approximate it. \figcredit  {Created by the authors.} }}{51}{figure.caption.64}\protected@file@percent }
\newlabel{fig:ddpm-sampling-formal-rev}{{2.5}{51}{\textbfs {Illustration of DDPM reverse (denoising) process.} Starting from noise $\mathbf {x}_L \sim p_{\mathrm {prior}}$, the model sequentially samples $\mathbf {x}_{i-1} \sim p(\mathbf {x}_{i-1}|\mathbf {x}_i)$ for $i=L,\ldots ,1$ to obtain a newly generated data $\mathbf {x}_0$. The oracle transition $p(\mathbf {x}_{i-1}|\mathbf {x}_i)$ is unknown; thus, we aim to approximate it. \figcredit {Created by the authors.}}{figure.caption.64}{}}
\newlabel{fig:ddpm-sampling-formal-rev@cref}{{[figure][5][2]2.5}{[1][51][]51}{}{}{}}
\@writefile{toc}{\contentsline {paragraph}{Overview: Modeling and Training Objective.}{51}{paragraph*.65}\protected@file@percent }
\newlabel{eq:marginal-kl-matching}{{2.2.2}{51}{Overview: Modeling and Training Objective}{equation.2.2.2}{}}
\newlabel{eq:marginal-kl-matching@cref}{{[equation][2][2,2]2.2.2}{[1][51][]51}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.6}{\ignorespaces {\sffamily  \textbf  {The conditioning trick in DDPM.}} {\sffamily  \textbf  {(Left)}} For a fixed noisy sample ${\mathbf  {x}}_i$, the reverse distribution $p({\mathbf  {x}}_{i-1}|{\mathbf  {x}}_i)$ averages over all possible clean samples ${\mathbf  {x}}_0$ that could have produced ${\mathbf  {x}}_i$. It can therefore be a complicated mixture. {\sffamily  \textbf  {(Right)}} During training, however, the clean sample ${\mathbf  {x}}_0$ used to generate ${\mathbf  {x}}_i$ is known. Conditioning on this sample gives $p({\mathbf  {x}}_{i-1}|{\mathbf  {x}}_i,{\mathbf  {x}}_0)$, a Gaussian with closed-form mean and variance. DDPM can therefore use this tractable conditional distribution as a simple regression target. Although each training example conditions on only one clean sample, averaging the conditional training objective over all samples gives the same optimal model as directly learning the marginal reverse distribution; see Theorem~\ref {thm:equiv-marginal-kl}. Thus, DDPM can learn the same optimal reverse prediction without directly regressing onto the complicated, generally intractable target induced by the marginal mixture. \figcredit  {Created by the authors with AI-assisted coding.}}}{52}{figure.caption.66}\protected@file@percent }
\newlabel{fig:conditional-trick}{{2.6}{52}{\textbfs {The conditioning trick in DDPM.} \textbfs {(Left)} For a fixed noisy sample $\rvx _i$, the reverse distribution $p(\rvx _{i-1}|\rvx _i)$ averages over all possible clean samples $\rvx _0$ that could have produced $\rvx _i$. It can therefore be a complicated mixture. \textbfs {(Right)} During training, however, the clean sample $\rvx _0$ used to generate $\rvx _i$ is known. Conditioning on this sample gives $p(\rvx _{i-1}|\rvx _i,\rvx _0)$, a Gaussian with closed-form mean and variance. DDPM can therefore use this tractable conditional distribution as a simple regression target. Although each training example conditions on only one clean sample, averaging the conditional training objective over all samples gives the same optimal model as directly learning the marginal reverse distribution; see Theorem~\ref {thm:equiv-marginal-kl}. Thus, DDPM can learn the same optimal reverse prediction without directly regressing onto the complicated, generally intractable target induced by the marginal mixture. \figcredit {Created by the authors with AI-assisted coding.}}{figure.caption.66}{}}
\newlabel{fig:conditional-trick@cref}{{[figure][6][2]2.6}{[1][52][]52}{}{}{}}
\@writefile{toc}{\contentsline {paragraph}{Overcoming Intractability with Conditioning.}{52}{paragraph*.67}\protected@file@percent }

\@writefile{lof}{\contentsline {figure}{\numberline {4.4}{\ignorespaces {\sffamily  \textbf  {Visualization of the reverse-time stochastic process for data generation.}} It begins from samples drawn from a simple prior distribution ($p_{\mathrm  {prior}}$) at $t=T$ (denoted as ``$\times $''), which are evolved backward in time using a reverse-SDE. The resulting trajectories terminate at $t=0$ and collectively form the target bimodal data distribution ($p_0 = p_{\mathrm  {data}}$). The background heatmap illustrates how the probability density is gradually transformed from a simple Gaussian into the complex target distribution. \figcredit  {Created by the authors.}}}{100}{figure.caption.122}\protected@file@percent }
\newlabel{fig:sde-density-back-traj}{{4.4}{100}{\textbfs {Visualization of the reverse-time stochastic process for data generation.} It begins from samples drawn from a simple prior distribution ($p_{\mathrm {prior}}$) at $t=T$ (denoted as ``$\times $''), which are evolved backward in time using a reverse-SDE. The resulting trajectories terminate at $t=0$ and collectively form the target bimodal data distribution ($p_0 = p_{\mathrm {data}}$). The background heatmap illustrates how the probability density is gradually transformed from a simple Gaussian into the complex target distribution. \figcredit {Created by the authors.}}{figure.caption.122}{}}
